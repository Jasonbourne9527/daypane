# dependencies
node_modules/

# local DBs (never commit live or fixture data)
*.db
*.db-wal
*.db-shm
test/fixtures/*.db

# WorkBuddy internal state
.workbuddy/

# jailbreak binaries (large, downloaded assets; MANIFEST.md + README.md are tracked)
kindle-jailbreak/*.zip
kindle-jailbreak/*.bin
kindle-jailbreak/*.tar.xz

# misc
.DS_Store
npm-debug.log*
kindle-dash-export.zip
export/*.zip

# preview artifacts
tools/*.png

# runtime logs / cache
tools/*.log
tools/__pycache__/
tools/tmp/
*.pyc

# 本机上报的额度快照（由上报器通过 GitHub API 推送，不进 git）
data/quotas.json

# 上报器密钥与日志
tools/report_secrets.bat
tools/report_quota.log

# 下载的 CJK 字体（CI 用 apt 或按需下载，不进仓库）
fonts/

_site/
render-work/
runtime-input/
.env

node_modules

dist/
# 含 token 的本地备份，绝对不要提交
tools/report_secrets.bat.bak_*
